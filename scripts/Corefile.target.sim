# CODoH Target — SIMULATION mode (no SGX, no attestation).
#
# Differs from repos/coredns/Corefile.target only by omitting `enclave_url`,
# which disables the attestation-based signing-key provisioning step (the enclave
# runs in simulation mode and skips signature verification when no target key is
# provisioned).
#
# `upstream` is the recursive resolver for the real query. run-codoh-sim.sh
# rewrites it (and sets the cover resolver) from the RESOLVER env var, so the
# end-to-end test needs outbound UDP/53 to that address. On an egress-restricted
# host run with `RESOLVER=<host:53>` (or edit the line below for standalone use).

.:25356 {
    codohtarget {
        port 8443
        tls_cert localhost.pem
        tls_key localhost-key.pem
        signing_key /tmp/target-signing.pem
        upstream 8.8.8.8:53
        log_queries true
    }

    errors
    log
}
